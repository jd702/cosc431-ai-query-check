# Copy this file to .env and paste in YOUR OWN personal keys.
# .env is git-ignored. Never commit it or paste keys in the team chat.

# https://aistudio.google.com  ->  "Get API key"
GEMINI_API_KEY=

# https://console.groq.com  ->  "API Keys"
GROQ_API_KEY=

# --- Model names: CHECKED 2026-11-25 ------------------------------------------
# Both of the ids we originally planned on have changed status since the project
# guide was written. Verify these in your own console before the run, then record
# the exact ids and the run date in the report's methodology section.
#
# Gemini: gemini-2.5-flash-lite still works but is restricted to projects that
#   already used 2.5 models; Google points new projects at 3.5 Flash-Lite.
# Groq:  llama-3.1-8b-instant was SHUT DOWN on 2026-08-16. Groq's deprecation
#   page lists openai/gpt-oss-20b as the replacement. (Groq's model list page
#   still shows the Llama id, so check which one your account can actually call
#   — scripts/check_keys.py will tell you in one command.)
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-20b
