# Copy this file to .env and paste in YOUR OWN personal keys.
# .env is git-ignored. Never commit it or paste keys in the team chat.

# https://aistudio.google.com  -> "Get API key"
GEMINI_API_KEY=

# https://console.groq.com  -> "API Keys"
GROQ_API_KEY=

# Check the current model names on each provider's site before running Deliverable 2
GEMINI_MODEL=gemini-2.5-flash-lite
GROQ_MODEL=llama-3.1-8b-instant
